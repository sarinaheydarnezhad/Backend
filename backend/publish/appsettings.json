{
  "Auth": {
    "Issuer": "Flashcards.Api",
    "Audience": "Flashcards.Mobile"
  },
  "Sms": {
    "Provider": "SmsIr"
  },
  "Backups": {
    "RetentionDays": 30,
    "MaxPayloadBytes": 10485760,
    "MaxStoredBackupsPerUser": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  }
}
