<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.1" />
    <!-- Preserve the existing resolved cryptography version while removing the unused code-exchange SDK. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Content/curriculum.json" />
    <EmbeddedResource Include="Content/curriculum-2026.json" Condition="Exists('Content/curriculum-2026.json')" />
    <EmbeddedResource Include="Content/curriculum-2026-r2.json" Condition="Exists('Content/curriculum-2026-r2.json')" />
    <EmbeddedResource Include="Content/Sources/**/*.html" />
  </ItemGroup>
</Project>
