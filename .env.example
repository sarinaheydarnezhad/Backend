# Copy to .env for Lerona SMS settings. Never commit .env or real credentials.
# The API loads these SMS settings only; host environment variables take precedence.
# Supply database, JWT, backup and Cent settings separately in the hosting environment.
Sms__Provider=Kavenegar
Kavenegar__ApiKey=YOUR_KAVENEGAR_API_KEY
Kavenegar__OtpTemplate=YOUR_APPROVED_TEMPLATE_NAME
Kavenegar__TimeoutSeconds=10
Otp__Length=6
Otp__ExpirationSeconds=120
Otp__ResendCooldownSeconds=60
Otp__MaxAttempts=5
Otp__MaxRequestsPerHour=5
